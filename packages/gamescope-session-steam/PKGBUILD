# Original Maintainer: Alesh Slovak <aleshslovak at gmail dot com>

pkgname=gamescope-session-steam
_commit=0000000000000000000000000000000000000000
pkgver=1
pkgrel=1
pkgdesc="Steam Big Picture session based on gamescope"
arch=('any')
url="https://github.com/OpenGamingCollective/gamescope-session-steam"
license=('MIT')
groups=()
depends=('gamescope-ogc' 'gamescope-session')
optdepends=('chimera: for steam-tweaks integration'
            'frzr: chimeraos update system')
makedepends=('git')
source=("git+https://github.com/OpenGamingCollective/gamescope-session-steam.git#commit=$_commit")
md5sums=('SKIP')

pkgver() {
  cd "$srcdir/gamescope-session-steam"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd "$srcdir/gamescope-session-steam"
  cp -rv "${srcdir}/gamescope-session-steam/usr" "${pkgdir}/usr"
  install -Dm644 "${srcdir}/gamescope-session-steam/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # font workaround for initial big picture mode startup
  mkdir -p "${pkgdir}/usr/share/fonts/truetype/ttf-dejavu"
  ln -s "/usr/share/fonts/TTF/DejaVuSans.ttf" "${pkgdir}/usr/share/fonts/truetype/ttf-dejavu/DejaVuSans.ttf"
}
